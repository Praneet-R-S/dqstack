# Copy to .env and fill in. Never commit the real file (.gitignore excludes it).
# docker compose reads it; so does `python -m dqstack.app.manage`.

# development | staging | production. Production refuses to start if anything
# below is unsafe: default secret, SQLite, insecure cookies, or a non-https URL.
DQ_ENV=production

# At least 32 random characters. Generate one with:
#   python -m dqstack.app.config
DQ_SECRET_KEY=

# The domain people use. Caddy gets its HTTPS certificate automatically; point the
# domain's DNS at this server first.
DQ_DOMAIN=dqstack.example.in

# PostgreSQL (docker-compose.yml). Three passwords, all different, all long:
#   POSTGRES_PASSWORD  the database superuser (backups only)
#   DQ_OWNER_PASSWORD  dqstack_owner: owns the tables; migrations run as it
#   DQ_APP_PASSWORD    dqstack_app: what the application connects as. It does not own
#                      the tables, so it cannot disable the triggers that keep stock
#                      movements and the activity log append-only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_1
POSTGRES_DB=dqstack
DQ_OWNER_PASSWORD=CHANGE_ME_2
DQ_APP_PASSWORD=CHANGE_ME_3
# docker-compose.yml builds DATABASE_URL from the values above. Set it yourself only
# when running without compose, for example against a managed PostgreSQL:
# DATABASE_URL=postgresql+psycopg://dqstack_app:PASSWORD@HOST:5432/dqstack

# Where people reach the site. Used in invitation and password-reset links.
DQ_PUBLIC_URL=https://dqstack.example.in
# Web server processes, about one per CPU core.
WEB_CONCURRENCY=2
# Database connections per web process (pool + overflow, default 10 + 20). Each process
# works on that many API requests at once, less a few spare, and queues the rest. Keep
# WEB_CONCURRENCY x (pool + overflow), plus about 10 for the worker, under the database's
# max_connections: lower these on a managed database with a small limit.
# DQ_DB_POOL_SIZE=10
# DQ_DB_MAX_OVERFLOW=20
DQ_COOKIE_SECURE=true

# Sign-in rules (section 15 defaults).
DQ_SESSION_HOURS=12
DQ_LOCKOUT_FAILURES=5
DQ_LOCKOUT_MINUTES=15

# Email for invitations, password resets and alerts. Leave DQ_SMTP_HOST empty to
# write messages to the server log instead of sending them.
DQ_SMTP_HOST=
DQ_SMTP_PORT=587
DQ_SMTP_USER=
DQ_SMTP_PASSWORD=
DQ_MAIL_FROM=DQ-Stack <no-reply@dqstack.example.in>

# WhatsApp Business Cloud API (Meta). Leave the token empty and WhatsApp works by
# link: the person's own phone opens WhatsApp with the message filled in. Set both
# and the server sends purchase orders (with the PDF), alerts and receipts itself.
# The token is a permanent system-user token from Meta Business Manager; the phone
# number id is the number's id in WhatsApp Manager, not the phone number.
DQ_WHATSAPP_TOKEN=
DQ_WHATSAPP_PHONE_NUMBER_ID=
DQ_WHATSAPP_API_VERSION=v21.0
# Approved message templates (deploy/README.md section 11 lists their blanks).
# WhatsApp only delivers a business-started message through an approved template;
# leave a name empty and that message goes as plain text, which WhatsApp delivers
# only within 24 hours of the person's last message to the business.
DQ_WHATSAPP_TEMPLATE_PO=
DQ_WHATSAPP_TEMPLATE_ALERT=
DQ_WHATSAPP_TEMPLATE_RECEIPT=
DQ_WHATSAPP_LANGUAGE=en

# Text messages (SMS) for receipts. Empty: the Send by SMS button says texts are not
# set up. twilio: DQ_TWILIO_ACCOUNT_SID, DQ_TWILIO_AUTH_TOKEN, DQ_SMS_FROM.
# webhook: any Indian gateway (MSG91, Gupshup, Exotel ...) behind a small adapter
# that takes {"to", "text"} as JSON. Indian gateways deliver only DLT-registered
# templates: register the receipt text first (deploy/README.md section 11).
DQ_SMS_PROVIDER=
DQ_TWILIO_ACCOUNT_SID=
DQ_TWILIO_AUTH_TOKEN=
DQ_SMS_FROM=
DQ_SMS_WEBHOOK_URL=
DQ_SMS_WEBHOOK_TOKEN=

# Google and Microsoft sign-in (optional; deploy/README.md section 12). Each button
# shows only when both its id and secret are set. Redirect address to register:
#   https://YOUR-DOMAIN/api/auth/oidc/google/callback  (and .../microsoft/callback)
# Sign-in codes by text message use the SMS provider above (DQ_SMS_PROVIDER).
DQ_GOOGLE_CLIENT_ID=
DQ_GOOGLE_CLIENT_SECRET=
DQ_MICROSOFT_CLIENT_ID=
DQ_MICROSOFT_CLIENT_SECRET=
# organizations (any work or school account), common, consumers, or one tenant id.
DQ_MICROSOFT_TENANT=organizations

# One-click demo sign-in on the sign-in page (needs a demo company: manage seed-demo).
# On by itself only in development. On a public server anyone can then sign in to the
# demo company, so its people cannot invite, change roles, company settings or
# connections. Leave it off on a server with real clients unless you want visitors in.
# DQ_DEMO_LOGINS=true

# The nightly file drop by SFTP (optional; deploy/README.md section 13), for billing
# systems that cannot call the POS API. Started with `docker compose --profile sftp up -d`;
# folders are added with `manage sftp-add-folder`. Key-based login only.
# The port the SFTP server listens on (open it only to the clients' addresses).
DQ_SFTP_PORT=2222
# Seconds a file must be left alone before it is read (so a half-uploaded file is not),
# and how often the worker looks.
DQ_SFTP_SETTLE_SECONDS=60
DQ_SFTP_EVERY_SECONDS=30

# Backups (deploy/README.md section 5). Two independent copies:
#   1. WAL-G (the pitr service): every change, shipped at least every 5 minutes, plus
#      a nightly base backup; restore to any moment of the last 7 days with
#      deploy/restore-to-time.sh. Losing the whole server loses about 5 minutes.
#   2. A nightly pg_dump (the backup service) in the backups volume, kept 30 days.
#
# Where WAL-G keeps them. Object storage in another place than this server (another
# region or provider) is the real backup; set WALG_S3_PREFIX for it. Any
# S3-compatible store works: AWS S3, or one with AWS_ENDPOINT, e.g.
# https://s3.ap-south-1.wasabisys.com or a MinIO/Ceph you run elsewhere
# (AWS_S3_FORCE_PATH_STYLE=true for most non-AWS stores).
WALG_S3_PREFIX=
AWS_ENDPOINT=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_FORCE_PATH_STYLE=false
# Without WALG_S3_PREFIX, backups go to the walg volume on this same server. That
# protects against mistakes (a deleted table, a bad import) but NOT against losing
# the server or its disk. Small installs only, and copy it off the server.
# Set this empty to turn WAL archiving off altogether (not recommended).
WALG_FILE_PREFIX=/walg/dqstack
# Encryption before anything leaves the server: 64 hex characters from
#   openssl rand -hex 32
# Keep a copy somewhere other than this server (a password manager). Without it the
# backups cannot be read, by anyone, including you. Instead, or as well, object
# storage can encrypt at rest: WALG_S3_SSE=AES256 (or aws:kms with WALG_S3_SSE_KMS_ID).
WALG_LIBSODIUM_KEY=
WALG_LIBSODIUM_KEY_TRANSFORM=hex
WALG_S3_SSE=
# Seconds after which a part-filled WAL segment is shipped anyway: the most a total
# loss of the server can cost. 300 meets the 15-minute target with room to spare.
DQ_PITR_ARCHIVE_TIMEOUT=300
# The nightly base backup (local time, DQ_BACKUP_TZ), and how long to keep backups.
# 8 days of backups give a full 7-day restore window; fewer is refused.
DQ_PITR_BACKUP_AT=01:30
DQ_PITR_RETAIN_DAYS=8
DQ_BACKUP_TZ=Asia/Kolkata
# A full backup after this many nightly delta (changes-only) backups.
WALG_DELTA_MAX_STEPS=6
# Connections the database accepts; covers WEB_CONCURRENCY=4 plus the worker.
DQ_PG_MAX_CONNECTIONS=200
# Set by deploy/restore-to-time.sh when you switch to a restored database; the old
# volume is kept until you remove it. Leave it unset otherwise.
# DQ_PGDATA_VOLUME=dqstack_pgdata
