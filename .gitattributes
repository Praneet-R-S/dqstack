# Git on Windows would otherwise apply CRLF conversion to these and corrupt them.
*.pdf   binary
*.png   binary
*.parquet binary
*.arrow binary
# Scripts that run inside Linux containers must keep LF line endings, even when the
# repository is checked out on Windows (a CRLF shell script fails with "not found").
*.sh text eol=lf
Dockerfile text eol=lf
deploy/Caddyfile text eol=lf
docker-compose.yml text eol=lf
# The database image's build files and the CI drill files run inside Linux as well.
deploy/postgres/* text eol=lf
deploy/ci/* text eol=lf
# So do the SFTP file drop's sshd_config and start script.
deploy/sftp/* text eol=lf
