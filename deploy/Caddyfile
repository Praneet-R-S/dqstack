# HTTPS for DQ_DOMAIN, with certificates from Let's Encrypt obtained and renewed
# automatically. Point the domain's DNS at this server before starting.
{$DQ_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8000 {
		health_uri /api/health
	}
	request_body {
		max_size 30MB
	}
	log {
		output stdout
		format console
	}
}
